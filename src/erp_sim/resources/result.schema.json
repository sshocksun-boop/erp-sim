{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp-sim cxmr4103 response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "command", "queried_at", "query", "session", "data", "error"],
  "properties": {
    "schema_version": {"const": "2"},
    "ok": {"type": "boolean"},
    "command": {"const": "cxmr4103"},
    "queried_at": {"type": "string", "format": "date-time"},
    "query": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["pattern", "date_from", "date_to", "date_type", "include_internal"],
      "properties": {"pattern": {"type": "string"}, "date_from": {"type": "string", "format": "date"},
        "date_to": {"type": "string", "format": "date"}, "date_type": {"const": "order_date"}, "include_internal": {"const": true}}}]},
    "session": {"type": "object", "additionalProperties": false, "required": ["logout_verified"], "properties": {"logout_verified": {"type": "boolean"}}},
    "data": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["columns", "rows", "row_count", "expected_row_count", "order_count", "complete"],
      "properties": {
        "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
        "rows": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "string"}}},
        "row_count": {"type": "integer", "minimum": 0}, "expected_row_count": {"type": "integer", "minimum": 0},
        "order_count": {"type": "integer", "minimum": 0}, "complete": {"type": "boolean"}
      }}]},
    "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}]}
  },
  "allOf": [{"if": {"properties": {"ok": {"const": true}}}, "then": {
    "properties": {"query": {"type": "object"}, "data": {"type": "object", "properties": {"complete": {"const": true}}},
      "session": {"properties": {"logout_verified": {"const": true}}}, "error": {"type": "null"}}
  }, "else": {"properties": {"error": {"type": "object"}}}}]
}
