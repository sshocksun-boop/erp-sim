{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp-sim aimq102 response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "command", "queried_at", "query", "session", "data", "error"],
  "properties": {
    "schema_version": {"const": "2"},
    "ok": {"type": "boolean"},
    "command": {"const": "aimq102"},
    "queried_at": {"type": "string", "format": "date-time"},
    "query": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false, "required": ["item"],
       "properties": {"item": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"}}}
    ]},
    "session": {"type": "object", "additionalProperties": false,
                "required": ["logout_verified"],
                "properties": {"logout_verified": {"type": "boolean"}}},
    "data": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
       "required": ["item", "description", "specification",
                    "current_version", "group_code", "stock_unit", "source_code",
                    "replenish_code", "unit_policy", "second_unit", "consumable", "bonded",
                    "available_stock", "ordered_qty", "wo_material_prepared", "wo_material_short",
                    "purchase_request_qty", "purchase_order_qty", "wo_in_process",
                    "subcontract_in_process", "subcontract_iqc_inspect", "iqc_inspect",
                    "fqc_inspect", "projected_available_header", "projected_available_table",
                    "unavailable_stock", "setup_qty",
                    "columns", "rows", "row_count", "expected_row_count",
                    "warehouse_count", "complete"],
       "properties": {
         "item": {"type": "string"},
         "description": {"type": "string"},
         "specification": {"type": "string"},
         "current_version": {"type": "string"},
         "group_code": {"type": "string"},
         "stock_unit": {"type": "string"},
         "source_code": {"type": "string"},
         "replenish_code": {"type": "string"},
         "unit_policy": {"type": "string"},
         "second_unit": {"type": "string"},
         "consumable": {"type": "string"},
         "bonded": {"type": "string"},
         "available_stock": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "ordered_qty": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "wo_material_prepared": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "wo_material_short": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "purchase_request_qty": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "purchase_order_qty": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "wo_in_process": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "subcontract_in_process": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "subcontract_iqc_inspect": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "iqc_inspect": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "fqc_inspect": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "projected_available_header": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "projected_available_table": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "unavailable_stock": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "setup_qty": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
         "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                    "required": ["id", "label"],
                    "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
         "rows": {"type": "array", "items": {"type": "object",
                  "additionalProperties": {"type": "string"}}},
         "row_count": {"type": "integer", "minimum": 0},
         "expected_row_count": {"type": "integer", "minimum": 0},
         "warehouse_count": {"type": "integer", "minimum": 0},
         "complete": {"type": "boolean"}
       }}
    ]},
    "error": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false, "required": ["code", "message"],
       "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
    ]}
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}},
     "then": {"properties": {"query": {"type": "object"},
                            "data": {"type": "object", "properties": {"complete": {"const": true}}},
                            "session": {"properties": {"logout_verified": {"const": true}}},
                            "error": {"type": "null"}}},
     "else": {"properties": {"error": {"type": "object"}}}}
  ]
}
