        },
        "password": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$(?![\\s\\S])"
        },
        "config": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"
        },
        "listen_port": {
          "type": "integer",
          "minimum": 6400,
          "maximum": 6500
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
