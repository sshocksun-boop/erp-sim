          "const": "1",
          "default": "1"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"
        },
        "command": {
          "type": "string",
          "const": "cxmr4103"
        },
        "feature_args": {
